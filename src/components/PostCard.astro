---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const categoryLabelMap: Record<string, string> = {
  tech: "技术",
  books: "书评",
  movies: "影评",
  notes: "随笔",
};

const categoryLabel = categoryLabelMap[post.data.category] || post.data.category;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
})
  .format(post.data.pubDate)
  .replace(/\//g, "-");
---

<div class="py-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 sm:gap-4 group">
  <div class="flex items-baseline gap-2 min-w-0">
    <a
      href={`/blog/${post.id}`}
      class="text-sm font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate"
    >
      {post.data.title}
    </a>
  </div>

  <div class="flex items-center gap-3 text-xs text-neutral-400 dark:text-neutral-500 shrink-0 font-mono">
    <span>[{categoryLabel}]</span>
    <time datetime={post.data.pubDate.toISOString()}>
      {formattedDate}
    </time>
  </div>
</div>
