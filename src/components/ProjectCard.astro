---
import type { ProjectItem } from "../data/siteConfig";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<div class="py-3">
  <div class="flex items-baseline justify-between gap-2">
    <div class="flex items-baseline gap-2">
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-neutral-900 dark:text-neutral-100 hover:underline underline-offset-4"
      >
        {project.name}
      </a>
      {project.tagline && (
        <span class="text-xs text-neutral-400 dark:text-neutral-500">
          — {project.tagline}
        </span>
      )}
    </div>

    <div class="text-xs text-neutral-400 space-x-2 shrink-0">
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-neutral-800 dark:hover:text-neutral-200 transition-colors"
      >
        GitHub ↗
      </a>
      {project.demoUrl && (
        <>
          <span>·</span>
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-neutral-800 dark:hover:text-neutral-200 transition-colors"
          >
            Demo ↗
          </a>
        </>
      )}
    </div>
  </div>

  <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
    {project.description}
  </p>

  <p class="mt-1.5 text-xs text-neutral-400 dark:text-neutral-500 font-mono">
    {project.tags.join(" / ")}
  </p>
</div>
