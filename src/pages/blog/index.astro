---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const categories = [
  { key: "all", label: "全部" },
  { key: "tech", label: "技术" },
  { key: "books", label: "书评" },
  { key: "movies", label: "影评" },
  { key: "notes", label: "随笔" },
];
---

<Layout
  title="博客与文章"
  description="包含技术博客、读书笔记、影评及日常随笔。"
>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        博客与文章
      </h1>
      <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
        记录技术探索、阅读与观影感悟，以及一些碎碎念。
      </p>
    </div>

    <!-- 分类筛选器 -->
    <div class="flex flex-wrap gap-2 pt-2 border-b border-neutral-200/60 dark:border-neutral-800/60 pb-4">
      {categories.map((cat) => (
        <button
          type="button"
          data-category={cat.key}
          class="category-btn text-xs px-3 py-1.5 rounded-md font-medium transition-colors cursor-pointer text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800"
          class:list={[cat.key === "all" ? "active bg-neutral-200/70 dark:bg-neutral-800 text-neutral-950 dark:text-white" : ""]}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- 文章列表 -->
    <div id="posts-container" class="divide-y divide-neutral-100 dark:divide-neutral-800">
      {sortedPosts.map((post) => (
        <div data-post-category={post.data.category} class="post-item">
          <PostCard post={post} />
        </div>
      ))}
    </div>

    <div id="empty-state" class="hidden py-12 text-center text-sm text-neutral-500">
      当前分类暂无文章。
    </div>
  </div>
</Layout>

<script is:inline>
  const buttons = document.querySelectorAll('.category-btn');
  const postItems = document.querySelectorAll('.post-item');
  const emptyState = document.getElementById('empty-state');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-category');

      // 更新按钮高亮样式
      buttons.forEach((b) => {
        b.classList.remove('active', 'bg-neutral-200/70', 'dark:bg-neutral-800', 'text-neutral-950', 'dark:text-white');
        b.classList.add('text-neutral-600', 'dark:text-neutral-400');
      });
      btn.classList.add('active', 'bg-neutral-200/70', 'dark:bg-neutral-800', 'text-neutral-950', 'dark:text-white');
      btn.classList.remove('text-neutral-600', 'dark:text-neutral-400');

      // 筛选展示
      let visibleCount = 0;
      postItems.forEach((item) => {
        const itemCat = item.getAttribute('data-post-category');
        if (selected === 'all' || itemCat === selected) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  });
</script>
