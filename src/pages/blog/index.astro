---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const categories = [
  { key: "all", label: "全部" },
  { key: "tech", label: "技术" },
  { key: "books", label: "书评" },
  { key: "movies", label: "影评" },
  { key: "notes", label: "随笔" },
];
---

<Layout title="博客与笔记">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 pb-3 border-b border-neutral-200/80 dark:border-neutral-800/80">
      <h1 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
        博客与笔记
      </h1>

      <!-- 极简文字分类切换 -->
      <div class="flex items-center gap-3 text-xs">
        {categories.map((cat) => (
          <button
            type="button"
            data-category={cat.key}
            class="category-btn text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors cursor-pointer"
            class:list={[cat.key === "all" ? "active font-medium text-neutral-900 dark:text-white underline underline-offset-4" : ""]}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- 文章列表 -->
    <div id="posts-container" class="divide-y divide-neutral-100 dark:divide-neutral-800/80">
      {sortedPosts.map((post) => (
        <div data-post-category={post.data.category} class="post-item">
          <PostCard post={post} />
        </div>
      ))}
    </div>

    <div id="empty-state" class="hidden py-12 text-center text-xs text-neutral-400">
      该分类下暂无文章。
    </div>
  </div>
</Layout>

<script is:inline>
  const buttons = document.querySelectorAll('.category-btn');
  const postItems = document.querySelectorAll('.post-item');
  const emptyState = document.getElementById('empty-state');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-category');

      buttons.forEach((b) => {
        b.classList.remove('active', 'font-medium', 'text-neutral-900', 'dark:text-white', 'underline', 'underline-offset-4');
        b.classList.add('text-neutral-400');
      });
      btn.classList.add('active', 'font-medium', 'text-neutral-900', 'dark:text-white', 'underline', 'underline-offset-4');
      btn.classList.remove('text-neutral-400');

      let visibleCount = 0;
      postItems.forEach((item) => {
        const itemCat = item.getAttribute('data-post-category');
        if (selected === 'all' || itemCat === selected) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  });
</script>
