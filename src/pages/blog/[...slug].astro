---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categoryLabelMap: Record<string, string> = {
  tech: "技术",
  books: "书评",
  movies: "影评",
  notes: "随笔",
};

const categoryLabel = categoryLabelMap[post.data.category] || post.data.category;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
})
  .format(post.data.pubDate)
  .replace(/\//g, "-");
---

<Layout title={post.data.title} description={post.data.description}>
  <article>
    <!-- 返回导航 -->
    <div class="mb-6">
      <a
        href="/blog"
        class="text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        ← 返回列表
      </a>
    </div>

    <!-- 文章标题与元信息 -->
    <header class="mb-8 pb-4 border-b border-neutral-200 dark:border-neutral-800">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        {post.data.title}
      </h1>

      <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 font-mono">
        <time datetime={post.data.pubDate.toISOString()}>
          {formattedDate}
        </time>
        <span>·</span>
        <span>[{categoryLabel}]</span>
        {post.data.subjectAuthor && (
          <>
            <span>·</span>
            <span>{post.data.category === "books" ? "作者: " : "导演: "}{post.data.subjectAuthor}</span>
          </>
        )}
        {post.data.rating && (
          <>
            <span>·</span>
            <span>{"★".repeat(post.data.rating)}</span>
          </>
        )}
      </div>
    </header>

    <!-- 文章正文 -->
    <div class="prose dark:prose-invert prose-neutral max-w-none text-sm leading-relaxed prose-headings:font-semibold prose-a:text-neutral-900 dark:prose-a:text-neutral-100 prose-a:underline prose-pre:border prose-pre:border-neutral-200 dark:prose-pre:border-neutral-800">
      <Content />
    </div>

    <div class="mt-12 pt-4 border-t border-neutral-200 dark:border-neutral-800">
      <a
        href="/blog"
        class="text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        ← 返回博客列表
      </a>
    </div>
  </article>
</Layout>
