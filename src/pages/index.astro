---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { siteConfig, projectsData } from "../data/siteConfig";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);
---

<Layout>
  <!-- 个人简介（纯技术，无废话） -->
  <section class="space-y-2 mb-12">
    <h1 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 font-mono">
      yimindev
    </h1>
    <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
      软件工程师。关注 AI Agent、语义网关、系统架构与数据工程。
    </p>
    <div class="text-xs pt-1">
      <a
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 underline underline-offset-4"
      >
        GitHub: github.com/yimindev ↗
      </a>
    </div>
  </section>

  <!-- 开源项目 -->
  <section class="mb-12">
    <div class="flex items-baseline justify-between mb-2 pb-2 border-b border-neutral-200 dark:border-neutral-800">
      <h2 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
        开源项目
      </h2>
    </div>

    <div>
      {projectsData.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- 文章列表 -->
  <section>
    <div class="flex items-baseline justify-between mb-2 pb-2 border-b border-neutral-200 dark:border-neutral-800">
      <h2 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
        文章与笔记
      </h2>
      <a
        href="/blog"
        class="text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-200"
      >
        全部 →
      </a>
    </div>

    <div class="divide-y divide-neutral-100 dark:divide-neutral-900">
      {recentPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</Layout>
